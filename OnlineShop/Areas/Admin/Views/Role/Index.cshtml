@model List<Role>

@{
    ViewData["Title"] = "ROLES";
    int counter = 1;
    int totalRoles = Model?.Count() ?? 0;
}

<div class="admin-layout">
    @await Html.PartialAsync("_AdminSidebar")
    
    <div class="admin-content">
        <div class="admin-header">
            <h1 class="admin-title glitch-title" data-text=">_ ROLES">>_ ROLES</h1>
            <a asp-area="Admin" asp-controller="Role" asp-action="Create" class="cyber-btn primary">
                <i class="fas fa-plus-circle"></i> [ADD_ROLE]
            </a>
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="admin-table-wrapper">
                <table class="cyber-table admin-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>ROLE_NAME</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var role in Model)
                        {
                            <tr>
                                <td data-label="#">@counter</td>
                                <td data-label="ROLE_NAME">@role.Name</td>
                                <td data-label=" ">
                                    <form method="post" asp-area="Admin" asp-controller="Role" asp-action="Delete" style="display:inline;">
                                        <input type="hidden" name="roleId" value="@role.Id" />
                                        <button type="submit" class="cyber-btn small danger delete-btn">
                                            <i class="fas fa-trash-alt"></i> DELETE
                                        </button>
                                    </form>
                                </td>
                            </tr>
                            counter++;
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="3" class="total-row">
                                <span class="total-label">TOTAL ROLES:</span>
                                <span class="total-value">@totalRoles</span>
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-icon">
                    <i class="fas fa-user-tag"></i>
                    <span class="glitch-text">[NO_ROLES]</span>
                </div>
                <p class="empty-message">>_ NO_ROLES_FOUND_IN_SYSTEM</p>
                <a asp-area="Admin" asp-controller="Role" asp-action="Create" class="cyber-btn primary">
                    <i class="fas fa-plus-circle"></i> [ADD_ROLE]
                </a>
            </div>
        }
    </div>
</div>