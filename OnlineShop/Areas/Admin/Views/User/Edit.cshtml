@model User

@{
    ViewData["Title"] = "EDIT_USER";
}

<div class="admin-layout">
    @await Html.PartialAsync("_AdminSidebar")

    <div class="admin-content">
        <div class="admin-header">
            <h1 class="admin-title glitch-title" data-text=">_ EDIT_USER">>_ EDIT_USER</h1>
            <a asp-area="Admin" asp-controller="User" asp-action="Details" asp-route-id="@Model.Id" class="cyber-btn secondary small">
                <i class="fas fa-arrow-left"></i> [BACK]
            </a>
        </div>

        <div class="edit-product-card">
            <form method="post" class="edit-product-form" asp-area="Admin" asp-controller="User" asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="field-validation-error"></div>

                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="CreatedAt" />
                <input type="hidden" asp-for="RoleId" />
                <input type="hidden" asp-for="CartId" />
                <input type="hidden" asp-for="FavoriteId" />
                <input type="hidden" asp-for="OrderListId" />
                <input type="hidden" asp-for="ComparatorId" />

                <div class="form-row">
                    <div class="form-field half">
                        <label asp-for="FirstName"></label>
                        <input asp-for="FirstName" class="cyber-input" placeholder="John" />
                        <span asp-validation-for="FirstName" class="field-validation-error"></span>
                    </div>
                    <div class="form-field half">
                        <label asp-for="LastName"></label>
                        <input asp-for="LastName" class="cyber-input" placeholder="Doe" />
                        <span asp-validation-for="LastName" class="field-validation-error"></span>
                    </div>
                </div>

                <div class="form-field">
                    <label asp-for="Login"></label>
                    <input asp-for="Login" class="cyber-input" placeholder="YOUR_LOGIN" />
                    <span asp-validation-for="Login" class="field-validation-error"></span>
                </div>
                <div class="form-field">
                    <label asp-for="Phone"></label>
                    <input asp-for="Phone" class="cyber-input" placeholder="+7 999 123-45-67" />
                    <span asp-validation-for="Phone" class="field-validation-error"></span>
                </div>

                <div class="form-field">
                    <label asp-for="Email"></label>
                    <input asp-for="Email" class="cyber-input" readonly="readonly" />
                </div>

                <div class="form-field">
                    <label asp-for="Password"></label>
                    <input asp-for="Password" class="cyber-input" readonly="readonly" />
                </div>

                <div class="edit-actions">
                    <a asp-area="Admin" asp-controller="User" asp-action="Details" asp-route-id="@Model.Id" class="cyber-btn secondary">
                        <i class="fas fa-arrow-left"></i> [BACK]
                    </a>
                    <button type="submit" class="cyber-btn primary">
                        <i class="fas fa-save"></i> [UPDATE_USER]
                    </button>
                </div>
            </form>

            <div class="terminal-line">
                <span class="prompt">>_</span> EDIT_MODE :: MODIFY_USER_DATA
                <span class="blink-cursor">_</span>
            </div>
        </div>
    </div>
</div>