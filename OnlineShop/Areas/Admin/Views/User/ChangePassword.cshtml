@model ChangePassword

@{
    ViewData["Title"] = "CHANGE_PASSWORD";
}

<div class="admin-layout">
    @await Html.PartialAsync("_AdminSidebar")

    <div class="admin-content">
        <div class="admin-header">
            <h1 class="admin-title glitch-title" data-text=">_ CHANGE_PASSWORD">>_ CHANGE_PASSWORD</h1>
            <a asp-area="Admin" asp-controller="User" asp-action="Details" asp-route-id="@Model.UserId" class="cyber-btn secondary small">
                <i class="fas fa-arrow-left"></i> [BACK]
            </a>
        </div>

        <div class="edit-product-card">
            <form method="post" class="edit-product-form" asp-area="Admin" asp-controller="User" asp-action="ChangePassword">
                <div asp-validation-summary="ModelOnly" class="field-validation-error"></div>

                <input type="hidden" asp-for="UserId" />

                <div class="form-field">
                    <label asp-for="Password"></label>
                    <input asp-for="Password" class="cyber-input"/>
                    <span asp-validation-for="Password" class="field-validation-error"></span>
                </div>

                <div class="form-field">
                    <label asp-for="ConfirmPassword"></label>
                    <input asp-for="ConfirmPassword" class="cyber-input"/>
                    <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
                </div>

                <div class="edit-actions">
                    <a asp-area="Admin" asp-controller="User" asp-action="Details" asp-route-id="@Model.UserId" class="cyber-btn secondary">
                        <i class="fas fa-arrow-left"></i> [BACK]
                    </a>
                    <button type="submit" class="cyber-btn primary">
                        <i class="fas fa-key"></i> [UPDATE_PASSWORD]
                    </button>
                </div>
            </form>

            <div class="terminal-line">
                <span class="prompt">>_</span> CHANGE_PASSWORD_MODE :: SECURE_UPDATE
                <span class="blink-cursor">_</span>
            </div>
        </div>
    </div>
</div>