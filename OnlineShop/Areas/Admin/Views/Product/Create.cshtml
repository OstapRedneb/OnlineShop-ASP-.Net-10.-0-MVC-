@model Product

@{
    ViewData["Title"] = "Добавление товара";
}

<div class="admin-layout">
    @await Html.PartialAsync("_AdminSidebar")
    
    <div class="admin-content">
        <div class="admin-header">
            <h1 class="admin-title glitch-title" data-text=">_ CREATE_PRODUCT">>_ CREATE_PRODUCT</h1>
        </div>

        <div class="edit-product-card">
            <form method="post" class="edit-product-form">

                <div asp-validation-summary="ModelOnly"></div>

                <input asp-for="Id" type="hidden" value="@Guid.NewGuid()" />

                <div class="form-field">
                    <label asp-for="Name"></label>
                    <input asp-for="Name" class="cyber-input"/>
                    <span asp-validation-for="Name" class="field-validation-error"></span>
                </div>

                <div class="form-field">
                    <label asp-for="Price"></label>
                    <input asp-for="Price" class="cyber-input"/>
                    <span asp-validation-for="Price" class="field-validation-error"></span>
                </div>

                <div class="form-field">
                    <label asp-for="Description"></label>
                    <textarea asp-for="Description" class="cyber-textarea"></textarea>
                    <span asp-validation-for="Price" class="field-validation-error"></span>
                </div>

                <div class="edit-actions">
                    <a asp-area="Admin" asp-controller="Product" asp-action="Index" class="cyber-btn secondary">
                        <i class="fas fa-arrow-left"></i> [BACK]
                    </a>
                    <button type="submit" class="cyber-btn primary" asp-area="Admin" asp-controller="Product" asp-action="Create">
                        <i class="fas fa-plus-circle"></i> [CREATE_PRODUCT]
                    </button>
                </div>
            </form>

            <div class="terminal-line">
                <span class="prompt">>_</span> CREATE_MODE :: ADD_NEW_PRODUCT_TO_DATABASE
                <span class="blink-cursor">_</span>
            </div>
        </div>
    </div>
</div>