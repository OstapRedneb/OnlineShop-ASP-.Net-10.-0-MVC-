@model List<Product>

@{
    ViewData["Title"] = "Управление товарами";
    int counter = 1;
    int totalCount = Model?.Count() ?? 0;
}

<div class="admin-layout">
    @await Html.PartialAsync("_AdminSidebar")
    
    <div class="admin-content">
        <div class="admin-header">
            <h1 class="admin-title glitch-title" data-text=">_ PRODUCTS">>_ PRODUCTS</h1>
            <a asp-area="Admin" asp-controller="Product" asp-action="Create" class="cyber-btn primary">
                <i class="fas fa-plus-circle"></i> [ADD_NEW_PRODUCT]
            </a>
        </div>

        <div class="admin-table-wrapper">
            <table class="cyber-table admin-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Наименование товара</th>
                        <th>Цена, руб.</th>
                        <th colspan="2">Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var product in Model)
                        {
                            //Modal window
                            <div id="deleteModal-@product.Id" class="modal-overlay">
                                <div class="modal-card">
                                    <div class="modal-header">
                                        <span class="modal-title glitch-text">>_ CONFIRM_DELETE</span>
                                        <a href="#close" class="modal-close"><i class="fas fa-times"></i></a>
                                    </div>
                                    <div class="modal-body">
                                        <p class="modal-message">
                                            <i class="fas fa-exclamation-triangle"></i>
                                            ARE_YOU_SURE_YOU_WANT_TO_DELETE <span class="highlight">@product.Name</span>?
                                            <br />
                                            <span class="subtext">THIS_ACTION_CANNOT_BE_UNDONE</span>
                                        </p>
                                        <form method="post" asp-area="Admin" asp-controller="Product" asp-action="Delete" asp-route-id="@product.Id">
                                            <div class="modal-actions">
                                                <a href="#close" class="cyber-btn secondary">[CANCEL]</a>
                                                <button type="submit" class="cyber-btn danger">
                                                    <i class="fas fa-trash-alt"></i> [DELETE]
                                                </button>
                                            </div>
                                        </form>
                                    </div>
                                    <div class="terminal-line">
                                        <span class="prompt">>_</span> DELETE_OPERATION :: AWAITING_CONFIRMATION
                                        <span class="blink-cursor">_</span>
                                    </div>
                                </div>
                            </div>

                            //Product
                            <tr>
                                <td data-label="#">@counter</td>
                                <td data-label="Наименование товара">
                                    <a asp-area="Admin" asp-controller="Product" asp-action="Index" asp-route-id="@product.Id" class="product-link">
                                        @product.Name
                                    </a>
                                </td>
                                <td data-label="Цена, руб.">@product.Price.ToString("N2") ₽</td>
                                <td data-label="Действия">
                                    <a asp-area="Admin" asp-controller="Product" asp-action="Edit" asp-route-id="@product.Id" class="cyber-btn small edit-btn">
                                        <i class="fas fa-edit"></i> Редактировать
                                    </a>
                                </td>
                                <td data-label=" ">
                                    <a href="#deleteModal-@product.Id" class="cyber-btn small danger delete-btn">
                                        <i class="fas fa-trash-alt"></i> DELETE
                                    </a>
                                </td>
                            </tr>
                            counter++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="empty-row">>_ NO_PRODUCTS_FOUND_IN_DATABASE</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="5" class="total-row">
                            <span class="total-label">Общее количество товаров:</span>
                            <span class="total-value">@totalCount</span>
                        </td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>