@model RegisterData

@{
    ViewData["Title"] = "Регистрация";
}

<div class="cyber-auth">
    <div class="auth-container">
        <div class="auth-card">
            <div class="auth-glitch"></div>
            <div class="auth-header">
                <h1 class="auth-title glitch-title" data-text=">_ REGISTER_TERMINAL">>_ REGISTER_TERMINAL</h1>
                <div class="auth-subtitle">[CREATE_ACCOUNT]</div>
            </div>
            <form method="post" class="auth-form">
                <!-- Поля: Login, Password, ConfirmPassword, Email и т.д. -->
                <div asp-validation-summary="ModelOnly"></div>
                <div class="form-field">
                    <label asp-for="Name"></label>
                    <input class="cyber-input" asp-for="Name"/>
                    <span asp-validation-for="Name" class="field-validation-error"></span>
                </div>
                <div class="form-field">
                    <label asp-for="Password"></label>
                    <input class="cyber-input" asp-for="Password"/>
                    <span asp-validation-for="Password" class="field-validation-error"></span>
                </div>
                <div class="form-field">
                    <label asp-for="CopyPassword"></label>
                    <input class="cyber-input" asp-for="CopyPassword"/>
                    <span asp-validation-for="CopyPassword" class="field-validation-error"></span>
                </div>

                <div class="form-field">
                    <label asp-for="FirstName"></label>
                    <input class="cyber-input" asp-for="FirstName"/>
                    <span asp-validation-for="FirstName" class="field-validation-error"></span>
                </div>
                <div class="form-field">
                    <label asp-for="LastName"></label>
                    <input class="cyber-input" asp-for="LastName"/>
                    <span asp-validation-for="LastName" class="field-validation-error"></span>
                </div>
                <div class="form-field">
                    <label asp-for="Email"></label>
                    <input class="cyber-input" asp-for="Email"/>
                    <span asp-validation-for="Email" class="field-validation-error"></span>
                </div>
                <div class="form-field">
                    <label asp-for="Phone"></label>
                    <input class="cyber-input" asp-for="Phone"/>
                    <span asp-validation-for="Phone" class="field-validation-error"></span>
                </div>
                <button type="submit" class="cyber-btn primary" asp-controller="Account" asp-action="Register">
                    <i class="fas fa-user-plus"></i> Зарегистрироваться
                </button>
                <div class="auth-footer">
                    <a class="register-link" asp-controller="Account" asp-action="Login">Уже есть аккаунт? Войти</a>
                </div>
            </form>
            <div class="terminal-line">
                <span class="prompt">>_</span> SECURE_CHANNEL :: ENCRYPTION_ACTIVE
                <span class="blink-cursor">_</span>
            </div>
        </div>
    </div>
</div>