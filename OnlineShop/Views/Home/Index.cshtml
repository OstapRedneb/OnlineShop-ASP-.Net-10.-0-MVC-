@model IEnumerable<Product>

@{
    ViewData["Title"] = "NEURAL_CATALOG";
}

<div class="cyber-catalog">
    <div class="catalog-header">
        <h1 class="glitch-title" data-text=">_ AVAILABLE_HARDWARE">>_ AVAILABLE_HARDWARE</h1>
        <div class="terminal-stats">
            <span class="stat-badge">[ITEMS: @Model.Count()]</span>
            <span class="stat-badge">[SECURE_CONNECTION: TLS 1.3]</span>
        </div>
    </div>

    <!-- БЛОК ПОИСКА -->
    <div class="search-container">
        <form method="get" asp-action="Index" asp-controller="Home" class="search-form">
            <input type="text" name="searchString" placeholder="SEARCH_PRODUCTS..." class="cyber-input search-input" />
            <button type="submit" class="cyber-btn search-btn">
                <i class="fas fa-search"></i> [SEARCH]
            </button>
        </form>
    </div>

    <div class="products-grid">
        @foreach (var product in Model)
        {
            <div class="cyber-card" data-product-id="@product.Id">
                <div class="card-glitch"></div>

                <!-- ИКОНКА СРАВНЕНИЯ -->
                <a asp-controller="Comparator" asp-action="Add" asp-route-productId="@product.Id" class="compare-icon">
                    <i class="fas fa-balance-scale"></i>
                </a>

                <!-- СЕРДЕЧКО (избранное) -->
                <a asp-controller="Favorite" asp-action="Add" asp-route-productId="@product.Id" class="favorite-heart">
                    <i class="far fa-heart"></i>
                </a>

                <div class="card-content">
                    <div class="card-image">
                        <img src="~/img/glitch.gif" alt="@product.Name" loading="lazy" />
                        <div class="image-scan"></div>
                    </div>
                    <div class="card-info">
                        <h3 class="product-title">
                            <a asp-controller="Product" asp-action="Index" asp-route-id="@product.Id" class="product-link">
                                @product.Name
                            </a>
                        </h3>
                        <div class="price-block">
                            <span class="price-currency">¥</span>
                            <span class="price-value">@product.Price</span>
                            <span class="price-suffix">CR</span>
                        </div>
                        <a asp-controller="Cart" asp-action="Add" asp-route-productId="@product.Id" class="cyber-btn">
                            <i class="fas fa-cart-plus"></i> [ADD_TO_CART]
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>