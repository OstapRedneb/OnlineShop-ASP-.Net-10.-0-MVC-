@model IEnumerable<Product>

@{
    ViewData["Title"] = "NEURAL_CATALOG";
}

<div class="cyber-catalog">
    <div class="catalog-header">
        <h1 class="glitch-title" data-text=">_ AVAILABLE_HARDWARE">>_ AVAILABLE_HARDWARE</h1>
        <div class="terminal-stats">
            <span class="stat-badge">[ITEMS: @Model.Count()]</span>
            <span class="stat-badge">[SECURE_CONNECTION: TLS 1.3]</span>
        </div>
    </div>

    <div class="products-grid">
        @foreach (var product in Model)
        {
            <!-- Вся карточка будет кликабельна? Если да, оберни в <a> с нужным asp-хелпером. 
                 Я оставляю пока просто блок, переход по заголовку. -->
            <div class="cyber-card" data-product-id="@product.Id">
                <div class="card-glitch"></div>
                <div class="card-content">
                    <div class="card-image">
                        <img src="~/img/glitch.gif" alt="@product.Name" loading="lazy" />
                        <div class="image-scan"></div>
                    </div>
                    <div class="card-info">
                        <h3 class="product-title">
                            <!-- ССЫЛКА НА ДЕТАЛИ: заполни свой asp-хелпер -->
                            <a asp-controller="Product" asp-action="Index" asp-route-id="@product.Id" class="product-link">
                                @product.Name
                            </a>
                        </h3>
                        <div class="price-block">
                            <span class="price-currency">¥</span>
                            <span class="price-value">@product.Price</span>
                            <span class="price-suffix">CR</span>
                        </div>
                        <!-- КНОПКА ADD TO CART: заполни свой asp-хелпер (контроллер, экшен, параметры) -->
                        <a asp-controller="Cart" asp-action="Add" asp-route-id="@product.Id" class="cyber-btn">
                            <i class="fas fa-cart-plus"></i> [ADD_TO_CART]
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>