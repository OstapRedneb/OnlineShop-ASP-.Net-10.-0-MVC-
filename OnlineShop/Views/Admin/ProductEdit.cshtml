@model Product

@{
    ViewData["Title"] = "Редактирование товара";
}

<div class="admin-layout">
    @await Html.PartialAsync("_AdminSidebar")
    
    <div class="admin-content">
        <div class="admin-header">
            <h1 class="admin-title glitch-title" data-text=">_ EDIT_PRODUCT">>_ EDIT_PRODUCT</h1>
        </div>

        <div class="edit-product-card">
            <form method="post" class="edit-product-form">
                <input type="hidden" name="Id" value="@Model.Id" />
                <input type="hidden" name="IsDeleted" value="@Model.IsDeleted" />
                <div class="form-field">
                    <label for="name">Наименование товара</label>
                    <input type="text" id="name" name="Name" value="@Model.Name" class="cyber-input" required />
                </div>

                <div class="form-field">
                    <label for="price">Цена, руб.</label>
                    <input type="number" id="price" name="Price" value="@Model.Price" placeholder="@Model.Price" class="cyber-input" step="0.01" min="0" required />
                </div>

                <div class="form-field">
                    <label for="description">Описание (необязательно)</label>
                    <textarea id="description" name="Description" class="cyber-textarea" rows="4" placeholder="@(Model.Description ?? "У этого продукта нет описания")">@Model.Description</textarea>
                </div>

                <div class="edit-actions">
                    <a asp-controller="Admin" asp-action="Product" class="cyber-btn secondary">
                        <i class="fas fa-arrow-left"></i> [BACK]
                    </a>
                    <button type="submit" class="cyber-btn primary" asp-controller="Admin" asp-action="ProductSave">
                        <i class="fas fa-save"></i> [SAVE_CHANGES]
                    </button>
                </div>
            </form>

            <div class="terminal-line">
                <span class="prompt">>_</span> EDIT_MODE :: MODIFY_PRODUCT_DATA
                <span class="blink-cursor">_</span>
            </div>
        </div>
    </div>
</div>