@* @model List<Order>

@{
    ViewData["Title"] = "ORDERS";
    int counter = 1;
    int totalOrders = Model?.Count() ?? 0;
}

<div class="admin-layout">
    @await Html.PartialAsync("_AdminSidebar")
    
    <div class="admin-content">
        <div class="admin-header">
            <h1 class="admin-title glitch-title" data-text=">_ ORDERS">>_ ORDERS</h1>
            <span class="stat-badge">[TOTAL: @totalOrders]</span>
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="admin-table-wrapper">
                <table class="cyber-table admin-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>TOTAL (CR)</th>
                            <th>STATUS</th>
                            <th>USER</th>
                            <th>DATE</th>
                            <th>TIME</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td data-label="#">@counter</td>
                                <td data-label="TOTAL (CR)">¥@order.TotalPrice.ToString("N2")</td>
                                <td data-label="STATUS">
                                    <span class="status-badge @GetStatusClass(order.Status)">
                                        @order.Status.GetDisplayName()
                                    </span>
                                </td>
                                <td data-label="USER">@order.User?.UserName</td>
                                <td data-label="DATE">@order.CreatedAt.ToString("dd.MM.yyyy")</td>
                                <td data-label="TIME">@order.CreatedAt.ToString("HH:mm")</td>
                                <td data-label=" ">
                                    <a asp-controller="Admin" asp-action="OrderDetails" asp-route-orderId="@order.Id" class="cyber-btn small details-btn">
                                        <i class="fas fa-eye"></i> DETAILS
                                    </a>
                                </td>
                            </tr>
                            counter++;
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="7" class="total-row">
                                <span class="total-label">TOTAL ORDERS:</span>
                                <span class="total-value">@totalOrders</span>
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-icon">
                    <i class="fas fa-box-open"></i>
                    <span class="glitch-text">[NO_ORDERS]</span>
                </div>
                <p class="empty-message">>_ NO_ORDERS_FOUND_IN_STORAGE</p>
            </div>
        }
    </div>
</div>

@functions {
    // Вспомогательная функция для получения CSS-класса статуса
    private string GetStatusClass(OrderStatus status)
    {
        return status switch
        {
            OrderStatus.Pending => "status-pending",
            OrderStatus.Processing => "status-processing",
            OrderStatus.Shipped => "status-shipped",
            OrderStatus.Delivered => "status-delivered",
            OrderStatus.Cancelled => "status-cancelled",
            _ => ""
        };
    }
}

@* Расширение для получения отображаемого имени из атрибута Display *@
@* @using System.ComponentModel.DataAnnotations
@functions {
    public static string GetDisplayName(this Enum value)
    {
        var field = value.GetType().GetField(value.ToString());
        var attribute = field?.GetCustomAttribute<DisplayAttribute>();
        return attribute?.Name ?? value.ToString();
    }
} *@