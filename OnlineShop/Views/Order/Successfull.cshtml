@{
    ViewData["Title"] = "ORDER_COMPLETED";
}

<div class="cyber-success">
    <div class="success-card">
        <div class="success-icon">
            <i class="fas fa-check-circle"></i>
        </div>
        <h1 class="success-title glitch-title" data-text=">_ ORDER_CONFIRMED">>_ ORDER_CONFIRMED</h1>
        <div class="success-status">
            <span class="status-line">[STATUS]</span>
            <span class="status-value">TRANSMITTED // DELIVERY_PENDING</span>
        </div>
        <p class="success-message">
            YOUR NEURAL_INVOICE HAS BEEN PROCESSED.<br />
            A COURIER_DRONE WILL ARRIVE AT SPECIFIED COORDINATES.
        </p>
        <a asp-controller="Home" asp-action="Index" class="cyber-btn primary">
            <i class="fas fa-arrow-left"></i> [RETURN_TO_CATALOG]
        </a>
        <div class="terminal-footer">
            <span class="prompt">>_</span> TRANSACTION_ID: 0x7F3A9C2E :: SIGNAL_GREEN
        </div>
    </div>
</div>